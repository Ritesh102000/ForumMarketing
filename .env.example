# Copy to .env and fill in.

# ---------------------------------------------------------------- database
# Both instances point at the SAME Postgres. That shared database is what lets
# the local admin and the public form server run on different machines.
# Free options: neon.tech, supabase.com
FORMCRAFT_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
FORMCRAFT_DB_POOL_SIZE=5

# -------------------------------------------------------------------- role
# admin  → login, builder, responses. Bind to localhost. Only one of these.
# public → renders and accepts forms only. No login route exists at all.
FORMCRAFT_ROLE=admin

# Admin routes answer only to requests from this machine. Set to 1 ONLY if you
# put the admin instance behind your own authenticated proxy or VPN.
FORMCRAFT_ADMIN_ALLOW_REMOTE=0

# ------------------------------------------------------------------- brand
# Shown in the header, the sign-in screen, and the public form footer.
FORMCRAFT_BRAND_NAME=Get Brand Partners

# Optional. When set, the public form shows a "who is asking" card with the
# owner-avatar image. Leave blank to hide that card entirely.
FORMCRAFT_OWNER_NAME=
FORMCRAFT_OWNER_ROLE=

# ------------------------------------------------------------------- admin
# Not needed on a public instance. Generate with:
#   uv run python scripts/set_password.py
FORMCRAFT_ADMIN_USERNAME=admin
FORMCRAFT_ADMIN_PASSWORD_HASH=
FORMCRAFT_SECRET_KEY=

# ------------------------------------------------------------------ public
# The address people actually visit. Used for the share links shown in admin.
FORMCRAFT_BASE_URL=http://127.0.0.1:8480

# Set to 1 when the public instance is served over HTTPS.
FORMCRAFT_SECURE_COOKIES=0

# ------------------------------------------------------------ google sheets
# Leave GOOGLE_ENABLED=0 to run without any Google setup; forms still work and
# responses are stored in Postgres regardless.
FORMCRAFT_GOOGLE_ENABLED=0
FORMCRAFT_GOOGLE_CLIENT_SECRET_FILE=data/google_client_secret.json
FORMCRAFT_GOOGLE_TOKEN_FILE=data/google_token.json

# Serverless hosts have no writable disk. scripts/google_setup.py prints this
# blob for you to paste into Vercel; it replaces the token file when set.
FORMCRAFT_GOOGLE_TOKEN_JSON=

# ------------------------------------------------------- Catapult integration
# Server-to-server only. Use the same generated secret in Catapult, and set the
# two form IDs after running scripts/setup_catapult_forms.py.
FORMCRAFT_INGEST_SECRET=
FORMCRAFT_CATAPULT_CONTACT_FORM_ID=
FORMCRAFT_CATAPULT_DIAGNOSTIC_FORM_ID=
